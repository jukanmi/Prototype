    outcome: "\uAC80\uAC1D\uC774 \uB9D0\uC5C6\uC774 \uAE38\uC744 \uBE44\uCF1C \uC900\uB2E4."
  - label: "\uBB3C\uB7EC\uB09C\uB2E4"
