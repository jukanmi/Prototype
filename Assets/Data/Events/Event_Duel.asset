  - label: "\uAC80\uC744 \uBF51\uB294\uB2E4"
    goldDelta: 60
    hpDelta: 0
    grantCard: 0
    fight: 1
    outcome: "\uAC80\uAC1D\uC774 \uC6C3\uC73C\uBA70 \uAC80\uC744 \uACA8\uB208\uB2E4."
  - label: "\uD1B5\uD589\uB8CC\uB97C \uB0B8\uB2E4"
    goldDelta: -30
    hpDelta: 0
